{
  "source": "aidm original phrase table of the typed intents (M30.0b, one intent router). A row matches a reading of the sentence (patterns: regex templates, {slot} a fragment, {slot:group} a named object slot, {verbs} the row's verb alternatives); the lowest precedence that resolves wins. Lexicon entries are lowercase words.",
  "slots": {
    "try": "(?:try to |attempt to )?",
    "feet": "(?: (?:back )?(?:up|on (?:to )?(?:her|his|their) feet|to (?:her|his|their) feet))",
    "someone": "[a-z0-9' -]+?",
    "hero": "[a-z' -]+?",
    "thing": "[a-z0-9 ,'-]+?",
    "gear": "[a-z ,'-]+",
    "foe": "[a-z0-9' ,-]+?",
    "place": "[a-z0-9' -]+",
    "give_art": "(?:my |the |a |an |this |that |our )?",
    "give_own": "(?:my |the |our |this |that )",
    "art": "(?:my |the |a |an |this |that |our |some |his |her |their )?",
    "use_art": "(?:my |the |a |an |our |this |that |some |his |her |their )?",
    "equip_art": "(?:my |the |a |an |his |her |their |our )?",
    "take_art": "(?:the |a |an |that |this )?",
    "mine": "(?:my|the|his|her|their|our)",
    "money": "(?:(?P<n>\\d+|an?|one|two|three|four|five|six|seven|eight|nine|ten|some|a few) )?(?P<coin>gold|silver|copper|gp|sp|cp|coins?)(?: (?:gold |silver |copper )?(?:pieces?|coins?))?",
    "for": "(?: for .+)?",
    "at_target": "(?: (?:on|at|onto|into|against|to|toward|towards) (?:the |a |an |that |this )?(?P<target>[a-z0-9' -]+))?"
  },
